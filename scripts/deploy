#!/usr/bin/env bash
set -euo pipefail

[ -d node_modules ] || npm ci --include=dev --silent
[ -d dist/client ] || npm run build

if [ "$(git rev-parse --abbrev-ref HEAD)" != "main" ] || ! git diff --quiet HEAD; then
  echo "$(date -u +%FT%TZ) checkout is not a clean main, skipping deploy"
  exit 0
fi

git fetch --quiet origin main

previous="$(git rev-parse HEAD)"
target="$(git rev-parse origin/main)"
[ "$previous" = "$target" ] && exit 0

build_and_migrate() {
  git diff --quiet "$previous" "$target" -- package-lock.json || npm ci --include=dev --silent || return 1
  npm run build || return 1
  npm run migrate
}

git reset --hard --quiet "$target"

if ! build_and_migrate; then
  git reset --hard --quiet "$previous"
  ntfy publish --quiet --token "$(cat "$HOME/.ntfy/token")" \
    --title "todo deploy failed" \
    http://127.0.0.1:2586/parallax \
    "$(git rev-parse --short "$target") would not deploy; still serving $(git rev-parse --short "$previous")"
  exit 1
fi

launchctl kickstart -k "gui/$UID/org.nixos.todo"
echo "$(date -u +%FT%TZ) deployed $(git rev-parse --short HEAD)"
