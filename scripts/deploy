#!/usr/bin/env bash
set -euo pipefail

git fetch --quiet origin main

previous="$(git rev-parse HEAD)"
target="$(git rev-parse origin/main)"
[ "$previous" = "$target" ] && exit 0

git reset --hard --quiet "$target"

if [ ! -d node_modules ] || ! git diff --quiet "$previous" "$target" -- package-lock.json; then
  npm ci --include=dev --silent
fi

npm run build
launchctl kickstart -k "gui/$UID/org.nixos.todo"
echo "$(date -u +%FT%TZ) deployed $(git rev-parse --short HEAD)"
